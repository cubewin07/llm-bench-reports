{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-bench/public_result.schema.json",
  "title": "Public result record (one per model x task x epoch)",
  "description": "The ONLY shape allowed into the public reports repo. Every object is closed (additionalProperties: false) and no field can carry free text, so prompts, code, answer keys and transcripts cannot leak. A copy lives in llm-bench-reports/schema/; tests/test_consistency.py in the private repo keeps them identical.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "date", "harness_version", "prompt_version", "track", "model", "task", "epoch", "score", "flags", "usage", "latency_s"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "harness_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "prompt_version": {"type": "string", "pattern": "^[a-z0-9.-]{1,32}$"},
    "track": {"enum": ["controlled", "native"]},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "effort", "agent"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9-]{2,32}$"},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9._:@-]{2,80}$"},
        "effort": {"enum": ["default", "none", "minimal", "low", "medium", "high", "xhigh", "max"]},
        "agent": {"type": "string", "pattern": "^[a-z0-9._-]{2,40}$"},
        "knowledge_cutoff": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hid", "category", "kind", "split"],
      "properties": {
        "hid": {"type": "string", "pattern": "^[0-9a-f]{12}$", "description": "HMAC of the private task id and version; not reversible without the private salt."},
        "category": {"enum": ["bug_localization", "bug_fix", "feature", "test_writing", "debugging_rca", "code_comprehension", "security_review", "system_design", "migration_data", "ui_functional", "honesty"]},
        "kind": {"enum": ["patch", "findings", "answer", "rubric"]},
        "split": {"enum": ["dev", "heldout"]},
        "source": {"enum": ["planted", "history", "real", "synthetic"]},
        "difficulty": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "human_minutes": {"type": ["number", "null"], "minimum": 0},
        "solution_public_before_cutoff": {"type": ["boolean", "null"]}
      }
    },
    "epoch": {"type": "integer", "minimum": 1},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "resolved": {"type": ["boolean", "null"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "metrics": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,39}$"},
      "additionalProperties": {"type": ["number", "null"]}
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["harness_error", "budget_exhausted", "no_change", "regression", "test_tampering", "out_of_scope_edit", "no_verification", "overclaim", "fabricated_reference", "hallucinated_answer", "wrong_abstention", "misread_task", "wrong_localization", "right_place_wrong_fix", "partial_fix", "symptom_patch", "overengineered", "shallow_reasoning", "gave_up", "other"]}
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "latency_s": {"type": "number", "minimum": 0},
    "turns": {"type": ["integer", "null"], "minimum": 0},
    "tool_calls": {"type": ["integer", "null"], "minimum": 0}
  }
}
